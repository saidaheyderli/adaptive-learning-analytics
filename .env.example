# Copy this file to .env and fill in real values. .env is gitignored.

SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=adaptive_learning
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Required for the AI recommendations endpoint. Get a key at
# https://aistudio.google.com/apikey — free tier is enough for development.
GEMINI_API_KEY=
